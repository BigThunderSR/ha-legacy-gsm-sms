{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "Renovate",
    "dependencies"
  ],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "ignorePaths": [
    "z-addon-old-test/",
    "temp-pavelve/"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[\\w-]*\\.txt$/"
    ],
    "rangeStrategy": "bump"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gammu / python-gammu versions built from source in add-on Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)\\s+ARG \\w+_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "gammu/gammu",
        "gammu/python-gammu"
      ],
      "addLabels": [
        "gammu"
      ]
    },
    {
      "matchManagers": [
        "pip_requirements",
        "pip_setup",
        "pipenv",
        "poetry"
      ],
      "matchCategories": [
        "python"
      ],
      "addLabels": [
        "python"
      ]
    },
    {
      "matchManagers": [
        "npm",
        "yarn",
        "pnpm"
      ],
      "matchCategories": [
        "js"
      ],
      "addLabels": [
        "javascript"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "github_actions"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "addLabels": [
        "dockerfile"
      ]
    },
    {
      "matchPackageNames": [
        "/dockerfile/"
      ],
      "addLabels": [
        "dockerfile"
      ]
    },
    {
      "matchManagers": [
        "nvm"
      ],
      "addLabels": [
        "javascript",
        "nvm"
      ]
    },
    {
      "description": "Test Python must match the add-on's Alpine base image; bump manually with build.yaml",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/test-addon.yml"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    }
  ]
}
